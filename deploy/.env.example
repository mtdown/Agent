# 线上环境变量样例。真实值只存在于 GitHub Secrets 与服务器 /opt/cloudwiki/.env，
# 本文件只登记「有哪些变量」，不含任何真实密钥。
# GitHub Actions 会按这里列出的名字生成服务器上的 .env。

# --- 数据库 / 缓存（必填，自己设定，别用弱密码）---
DB_PASSWORD=
REDIS_PASSWORD=

# --- 腾讯云 COS（已停服，留空即可；compose 会兜底成占位值避免启动失败）---
COS_SECRET_ID=
COS_SECRET_KEY=

# --- RAG：DashScope embedding / rerank 共用一把 key ---
RAG_EMBEDDING_API_KEY=
# --- RAG：回答生成模型（DeepSeek 等 OpenAI 兼容端点）---
RAG_LLM_API_KEY=

# --- knife4j 接口文档（密码必填，application.yml 里没有默认值）---
DOC_USERNAME=admin
DOC_PASSWORD=

# --- nginx 对外端口：备案通过前 8080，备案通过后改成 80 ---
HTTP_PORT=8080
