  if (selected !== null) values.set(profiles.MODEL_PROFILE_STORAGE_KEY, selected)
  global.window = {
    localStorage: {
      getItem(key) {
        if (unavailable) throw new Error('storage unavailable')
        return values.get(key) ?? null
      },
      setItem(key, value) {
